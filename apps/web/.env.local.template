# Novel-Analyzer 前端 · 全外部依赖场景配置模板
#
# 用法:
#   cp apps/web/.env.local.template apps/web/.env.local
#   $EDITOR apps/web/.env.local
#   cd apps/web && npm run dev          # dev 自动 reload
#   cd apps/web && npm run build && npm run start    # 生产构建期注入
#
# 注意: 所有变量必须以 NEXT_PUBLIC_ 开头才会暴露给浏览器
#       改完 build 后必须重新构建,dev 模式会热更新

# 后端 FastAPI 地址 (workbench 默认值,用户在 UI 改过会存 localStorage)
NEXT_PUBLIC_API_BASE=http://api-host.your-domain:8011

# Workbench 默认数据库 URL (展示用,实际后端读后端的 .env.local)
NEXT_PUBLIC_DEFAULT_DATABASE_URL=postgresql+psycopg://novel_app:replace-me@db.your-host:5432/novel_analyzer

# Dify Writer Copilot iframe (不嵌入 Dify 就留空)
# NEXT_PUBLIC_DIFY_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_DIFY_WRITER_COPILOT_TOKEN=app-xxxxxxxxxx
