# Novel-Analyzer · 全外部依赖场景配置模板
#
# 用法:
#   cp .env.local.template .env.local
#   $EDITOR .env.local                    # 把所有 replace-me / your-host 换掉
#   .venv/bin/python scripts/dev/smoke-external.py    # 一键探针
#
# 适用场景: PostgreSQL / LLM / TEI Embedding / TEI Rerank 全部为外部服务
# 不适用: 想跑本地 ONNX 时请用 .env.example

# ─────────────────────────────────────────────────────────────────────────────
# 1. PostgreSQL (外部托管 / 自建实例)
# 必须开启扩展: pg_trgm, vector  | 强烈建议: pg_jieba (中文检索 R@5 +0.03)
# ─────────────────────────────────────────────────────────────────────────────
NOVEL_ANALYZER_DB_DIALECT=postgresql
NOVEL_ANALYZER_DB_HOST=db.your-host.internal
NOVEL_ANALYZER_DB_PORT=5432
NOVEL_ANALYZER_DB_USER=novel_app
NOVEL_ANALYZER_DB_PASSWORD=replace-me
NOVEL_ANALYZER_DB_NAME=novel_analyzer
NOVEL_ANALYZER_DB_ADMIN_NAME=postgres

# 想直接给 SQLAlchemy URL (优先级高于上面的分项):
# NOVEL_ANALYZER_DATABASE_URL=postgresql+psycopg://novel_app:pwd@db.host:5432/novel_analyzer

# ─────────────────────────────────────────────────────────────────────────────
# 2. LLM (DeepSeek / OpenAI 兼容网关)
# ─────────────────────────────────────────────────────────────────────────────
NOVEL_ANALYZER_LLM_PROVIDER_NAME=deepseek
NOVEL_ANALYZER_LLM_BASE_URL=https://api.deepseek.com/v1
NOVEL_ANALYZER_LLM_API_KEY=replace-me
NOVEL_ANALYZER_LLM_MODEL_NAME=deepseek-chat
NOVEL_ANALYZER_LLM_STAGE_MODEL_NAME=deepseek-chat
NOVEL_ANALYZER_LLM_QA_MODEL_NAME=deepseek-chat
NOVEL_ANALYZER_LLM_FALLBACK_MODEL_NAME=deepseek-chat
NOVEL_ANALYZER_LLM_TIMEOUT_SECONDS=180
NOVEL_ANALYZER_LLM_MAX_RETRIES=2
NOVEL_ANALYZER_USE_MERGED_STAGES=true

# 走 Helicone proxy 时取消注释:
# NOVEL_ANALYZER_LLM_BASE_URL_OVERRIDE=https://your-helicone/v1/openai

# ─────────────────────────────────────────────────────────────────────────────
# 3. Embedding (外部 TEI / 无鉴权)
# format=tei  -> POST /embed       | format=openai -> POST /v1/embeddings
# ─────────────────────────────────────────────────────────────────────────────
NOVEL_ANALYZER_EMBEDDING_BACKEND=http
NOVEL_ANALYZER_EMBEDDING_MODEL_NAME=BAAI/bge-m3
NOVEL_ANALYZER_EMBEDDING_API_BASE=http://tei.your-host.internal:8080
NOVEL_ANALYZER_EMBEDDING_API_KEY=
NOVEL_ANALYZER_EMBEDDING_API_FORMAT=tei
NOVEL_ANALYZER_EMBEDDING_HTTP_TIMEOUT=30.0
NOVEL_ANALYZER_EMBEDDING_HTTP_MAX_RETRIES=2
NOVEL_ANALYZER_EMBEDDING_HTTP_VERIFY_SSL=true
NOVEL_ANALYZER_EMBEDDING_HTTP_BATCH_SIZE=0
NOVEL_ANALYZER_EMBEDDING_FALLBACK_BACKEND=
NOVEL_ANALYZER_EMBEDDING_FALLBACK_AFTER_FAILURES=3
NOVEL_ANALYZER_EMBEDDING_CACHE_DIR=.cache/embeddings

# ─────────────────────────────────────────────────────────────────────────────
# 4. Rerank (外部 TEI / 无鉴权)
# format 目前只支持 tei
# ─────────────────────────────────────────────────────────────────────────────
NOVEL_ANALYZER_RERANK_BACKEND=http
NOVEL_ANALYZER_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
NOVEL_ANALYZER_RERANK_API_BASE=http://tei.your-host.internal:8081
NOVEL_ANALYZER_RERANK_API_KEY=
NOVEL_ANALYZER_RERANK_API_FORMAT=tei
NOVEL_ANALYZER_RERANK_HTTP_TIMEOUT=30.0
NOVEL_ANALYZER_RERANK_HTTP_MAX_RETRIES=2
NOVEL_ANALYZER_RERANK_HTTP_VERIFY_SSL=true

# ─────────────────────────────────────────────────────────────────────────────
# 5. 其它 (一般保持默认)
# ─────────────────────────────────────────────────────────────────────────────
NOVEL_ANALYZER_RUNTIME_CACHE_DIR=.cache/novel-analyzer

# n8n pipeline 完成 webhook (不设则静默)
# N8N_WEBHOOK_PIPELINE_COMPLETE_URL=http://localhost:5678/webhook/pipeline-complete
