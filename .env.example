NOVEL_ANALYZER_DB_DIALECT=postgresql
NOVEL_ANALYZER_DB_HOST=127.0.0.1
NOVEL_ANALYZER_DB_PORT=5432
NOVEL_ANALYZER_DB_USER=d2
NOVEL_ANALYZER_DB_PASSWORD=replace-me
NOVEL_ANALYZER_DB_NAME=novel_analyzer
NOVEL_ANALYZER_DB_ADMIN_NAME=postgres
# Or set the full URL directly (overrides DB_HOST/PORT/USER/PASSWORD/NAME):
# NOVEL_ANALYZER_DATABASE_URL=postgresql+psycopg://user:pwd@host:5432/novel_analyzer

NOVEL_ANALYZER_LLM_PROVIDER_NAME=deepseek
NOVEL_ANALYZER_LLM_BASE_URL=https://api.deepseek.com/v1
NOVEL_ANALYZER_LLM_API_KEY=replace-me
NOVEL_ANALYZER_LLM_MODEL_NAME=deepseek-v4-flash
NOVEL_ANALYZER_LLM_STAGE_MODEL_NAME=deepseek-v4-flash
NOVEL_ANALYZER_LLM_QA_MODEL_NAME=deepseek-v4-flash
NOVEL_ANALYZER_LLM_FALLBACK_MODEL_NAME=deepseek-v4-flash
NOVEL_ANALYZER_USE_MERGED_STAGES=true

# ── Embedding ───────────────────────────────────────────────────────────────
# Local ONNX (default) — needs EMBEDDING_MODEL_PATH pointing to local files
NOVEL_ANALYZER_EMBEDDING_BACKEND=onnx
NOVEL_ANALYZER_EMBEDDING_MODEL_NAME=BAAI/bge-m3
NOVEL_ANALYZER_EMBEDDING_MODEL_PATH=/absolute/path/to/bge-m3-onnx
NOVEL_ANALYZER_EMBEDDING_CACHE_DIR=.cache/embeddings

# External TEI/OpenAI HTTP backend — comment out the ONNX line above and set:
#   NOVEL_ANALYZER_EMBEDDING_BACKEND=http
#   NOVEL_ANALYZER_EMBEDDING_API_BASE=http://tei-host:8080
#   NOVEL_ANALYZER_EMBEDDING_API_FORMAT=tei      # tei | openai
#   NOVEL_ANALYZER_EMBEDDING_API_KEY=            # leave empty if no auth
#   NOVEL_ANALYZER_EMBEDDING_HTTP_TIMEOUT=30.0
#   NOVEL_ANALYZER_EMBEDDING_HTTP_MAX_RETRIES=2
#   NOVEL_ANALYZER_EMBEDDING_HTTP_BATCH_SIZE=0   # 0=auto (TEI=32, OpenAI=2048)
#   NOVEL_ANALYZER_EMBEDDING_FALLBACK_BACKEND=   # "" or "onnx"
#   NOVEL_ANALYZER_EMBEDDING_FALLBACK_AFTER_FAILURES=3

# ── Rerank ──────────────────────────────────────────────────────────────────
# External TEI rerank server (only "tei" format supported):
#   NOVEL_ANALYZER_RERANK_BACKEND=http
#   NOVEL_ANALYZER_RERANK_API_BASE=http://tei-host:8081
#   NOVEL_ANALYZER_RERANK_API_FORMAT=tei
#   NOVEL_ANALYZER_RERANK_API_KEY=
#   NOVEL_ANALYZER_RERANK_HTTP_TIMEOUT=30.0
#   NOVEL_ANALYZER_RERANK_HTTP_MAX_RETRIES=2
#   NOVEL_ANALYZER_RERANK_HTTP_BATCH_SIZE=0

# ── v3: 外围集成（可选）──────────────────────────────────────────────────────
#
# n8n pipeline 完成通知
# 不设则静默（imitation 完成后不发 webhook）
# N8N_WEBHOOK_PIPELINE_COMPLETE_URL=http://localhost:5678/webhook/pipeline-complete
#
# Helicone 透明 LLM proxy（imitation 主流量 trace）
# 不设则直连 LLM_BASE_URL；设置后所有 build_chat_model() 调用经过 proxy
# NOVEL_ANALYZER_LLM_BASE_URL_OVERRIDE=http://localhost:8585/v1/openai
#
# ── 前端配置（apps/web/.env.local，独立文件）──────────────────────────────────
# 前端构建期变量必须以 NEXT_PUBLIC_ 开头，写在 apps/web/.env.local：
#   NEXT_PUBLIC_API_BASE=http://api-host:8011
#   NEXT_PUBLIC_DEFAULT_DATABASE_URL=postgresql+psycopg://user:pwd@host:5432/novel_analyzer
#   NEXT_PUBLIC_DIFY_BASE_URL=http://localhost:8080
#   NEXT_PUBLIC_DIFY_WRITER_COPILOT_TOKEN=app-xxxxxxxxxx
#
# ── 验证外部依赖 ─────────────────────────────────────────────────────────────
# .venv/bin/python scripts/dev/smoke-external.py
# 或: make smoke-external
